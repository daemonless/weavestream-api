#!/bin/sh
set -e

export APP_URL="${APP_URL:-http://localhost:3000}"
export API_URL="${API_URL:-http://localhost:3000/api}"

export PRISMA_SCHEMA_ENGINE_BINARY="${PRISMA_SCHEMA_ENGINE_BINARY:-/usr/local/libexec/prisma-engines/schema-engine}"
export PRISMA_QUERY_ENGINE_LIBRARY="${PRISMA_QUERY_ENGINE_LIBRARY:-/usr/local/libexec/prisma-engines/libquery_engine.node}"

# Run migrations if DATABASE_URL is configured
if [ -n "${DATABASE_URL:-}" ]; then
  echo "[weavestream-api] Running database migrations..."
  cd /app/packages/db && ./node_modules/.bin/prisma migrate deploy
fi

cd /app/apps/api
exec node dist/main.js
